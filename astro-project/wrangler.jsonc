{
  // Sito statico su Workers static assets (ADR-0001). Gli header di sicurezza e
  // cache stanno in public/_headers, che Cloudflare applica agli asset statici.
  //
  // Il Worker esiste per una sola rotta: `/`, dove sceglie la lingua dal paese
  // (ADR-0001 §4). Senza `run_worker_first` la root verrebbe risolta da index.html
  // prima che il Worker giri, e il redirect non avverrebbe mai.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcobellingeri-dev",
  // sentry.js = index.js avvolto in Sentry (error monitoring del Worker).
  // I test importano index.js puro; questo entry lo vede solo wrangler.
  "main": "worker/sentry.js",
  "compatibility_date": "2026-07-09",
  // Richiesto da @sentry/cloudflare (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  // Rate limiting del form di contatto: binding del runtime (GA, gratuito) —
  // NON la regola WAF, che sul piano free non c'è. 5 invii al minuto per IP.
  // URL dell'hub Agentic OS. Non e' un segreto: e' un hostname pubblico, protetto
  // da Cloudflare Access davanti e dal token della status API dietro — le due
  // credenziali vere stanno nei secret del Worker, non qui.
  // Senza questa var il Worker risponde con i tre campi a null e il widget mostra
  // i trattini: percorso testato, non un errore.
  "vars": {
    "AGENTIC_OS_STATUS_URL": "https://status.marcobellingeri.dev/status"
  },
  // Chi passa: umani o crawler, contati per famiglia (worker/crawler.js). Nel
  // piano free: 100k data point scritti al giorno, ~1.100 il traffico attuale.
  // Non e' un segreto: e' il nome di un dataset sul nostro account.
  "analytics_engine_datasets": [{ "binding": "CRAWLERS", "dataset": "crawler_passaggi" }],
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ASK_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Le pagine HTML passano dal Worker per essere contate (umani vs crawler IA):
    // un pageview E' una richiesta HTML. Misurato: con il Worker davanti gli
    // header di `_headers` continuano ad arrivare (`env.ASSETS.fetch` conserva la
    // risposta dell'asset), quindi la A+ dell'Observatory non e' in gioco.
    //
    // Le esclusioni non sono cosmetiche. Una richiesta di asset statico e'
    // gratuita e illimitata; una che invoca il Worker consuma la quota del piano
    // free (100k al giorno). Quindi restano fuori: `/_astro` e `/fonts` (la
    // maggior parte del volume e tutta la latenza che conta, e non sono
    // pageview), e i feed RSS — un lettore di feed polla ogni 15 minuti per
    // sempre, brucerebbe quota e si conterebbe come pageview senza essere una
    // lettura. Vedi il README per il tetto dichiarato e cosa fare se si avvicina.
    "run_worker_first": [
      "/", "/it/*", "/en/*",
      "/api/contact", "/api/ask", "/api/radar", "/api/agentic-status",
      "!/_astro/*", "!/fonts/*", "!/*.xml", "!/*.pdf", "!/*.txt", "!/*.json"
    ],
    // Un URL inesistente riceveva il 404 spoglio del runtime. Ora riceve dist/404.html.
    "not_found_handling": "404-page"
  },
  // Il dominio è già una zona su questo account (nameserver lara/frank.ns.cloudflare.com).
  "routes": [{ "pattern": "marcobellingeri.dev", "custom_domain": true }],
  // Senza questo il sito sarebbe servito anche su marcobellingeri-dev.workers.dev:
  // stesso contenuto a due indirizzi, con canonical e sitemap che puntano solo
  // all'apex. Contenuto duplicato per i motori, e una seconda superficie pubblica
  // che nessuno sorveglia.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
