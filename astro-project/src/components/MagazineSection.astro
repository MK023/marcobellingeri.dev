---
import { numeroSezione } from '../lib/sections';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { magazineSlug } from '../lib/magazine';
import Newsstand from './Newsstand.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import edicola from '../data/edicola.json';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;

// Ordine: il più recente per primo. Il mese in testa alla sezione esce da qui,
// non da una costante: pubblicare il numero di settembre è ciò che fa dire
// "Settembre" al sito. Niente data da ricordare a mano ogni mese.
const issues = (await getCollection('magazine', (c) => c.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// Il numero del mese si legge aperto; gli arretrati stanno in pila, come
// l'Edicola. Con un solo numero la pila non compare: `arretrati` è vuoto e la
// sezione resta identica a com'era prima che il secondo numero uscisse.
const [corrente, ...arretrati] = issues;

// Edicola: dove la firma di Marco esce anche fuori dal sito. Reso come una PILA
// da edicola (newsstand stack) — le firme impilate come giornali, sfalsate e
// ruotate. Solo link in uscita (nuova scheda). La fonte è src/data/edicola.json:
// le card dev.to le aggiunge da solo il cron Edicola card (engine/edicola.mjs),
// una card interna si aggiunge a mano con `path` al posto di `href`.

const copy = {
  it: {
    intro: "Ogni mese un caso vero su IA, sicurezza e governance sul lavoro: il problema, la scelta fatta, cosa è cambiato. Lo scrive una pipeline, controllato sulle fonti. Il primo è il punto zero: le idee migliorano strada facendo.",
    toggle: 'LEGGI',
    problem: 'PROBLEMA', approach: 'APPROCCIO', result: 'RISULTATO', lesson: 'LEZIONE APPRESA',
    permalink: 'Apri la pagina →',
    edicolaHead: 'Edicola · dove la firma esce anche fuori',
    profilo: 'Il profilo dev.to',
    newTab: 'si apre in una nuova scheda',
    arretratiHead: 'Numeri arretrati · la pila di quelli usciti prima',
  },
  en: {
    intro: 'One real case a month on AI, security and governance at work: the problem, the call made, what changed. A pipeline writes it, checked against the sources. The first one is point zero: ideas get better as you go.',
    toggle: 'READ',
    problem: 'PROBLEM', approach: 'APPROACH', result: 'RESULT', lesson: 'LESSON LEARNED',
    permalink: 'Open the page →',
    edicolaHead: 'Edicola · where the byline also runs',
    profilo: 'The dev.to profile',
    newTab: 'opens in a new tab',
    arretratiHead: 'Back issues · the stack of the ones before',
  },
}[lang];

// La pila è data-driven da edicola.json; il layout regge da 2 a molti (nuova
// firma ~1/settimana). `href` assoluto = firma esterna; `path` = pagina interna
// (es. audit-di-sé, casa canonical sul sito) risolta nella lingua corrente.
type Card = {
  slug?: string;
  label: Record<Lang, string>;
  sub: Record<Lang, string>;
  href?: string;
  path?: string;
};
const bylines = (edicola as Card[]).map((c) => ({
  label: c.label[lang],
  sub: c.sub[lang],
  href: c.href ?? getRelativeLocaleUrl(lang, c.path),
  // Una card con `path` sta in casa: niente nuova scheda ne' "(si apre in una
  // nuova scheda)" nell'aria-label per una pagina dello stesso sito.
  sameTab: !c.href,
}));

// Gli arretrati come voci della pila: la copertina è titolo + numero e mese.
const pilaArretrati = arretrati.map((issue) => ({
  label: issue.data.title,
  sub: `N.${String(issue.data.number).padStart(2, '0')} · ${issue.data.month}`,
  href: getRelativeLocaleUrl(lang, `magazine/${magazineSlug(issue)}`),
}));
---

<section id="magazine" class="reveal">
  <div class="section-head">
    <span class="num mono">{numeroSezione('magazine')}</span>
    <h2 class="display">Magazine</h2>
  </div>
  <p class="case-archive-note">{copy.intro}</p>
  <div class="mag-list">
    {corrente && (
      <details class="mag-item">
        <summary class="mag-summary">
          <div class="mag-stat-col">
            {corrente.data.stat != null ? (
              <div
                class="mag-stat display"
                id="mag-stat-0"
                data-target={corrente.data.stat}
                data-suffix={corrente.data.statSuffix ?? ''}
              >
                0{corrente.data.statSuffix ?? ''}
              </div>
            ) : (
              <div class="mag-number display">N.{String(corrente.data.number).padStart(2, '0')}</div>
            )}
            <span class="mag-cred mono">{corrente.data.month.toUpperCase()} · {corrente.data.sector}</span>
          </div>
          <div class="mag-summary-main">
            <h3 class="mag-title">{corrente.data.title}</h3>
            <span class="mag-toggle mono">{copy.toggle}</span>
          </div>
        </summary>
        <div class="mag-body">
          <div class="case-block"><span class="label mono">{copy.problem}</span><p>{corrente.data.problem}</p></div>
          <div class="case-block"><span class="label mono">{copy.approach}</span><p>{corrente.data.approach}</p></div>
          <div class="case-block"><span class="label mono">{copy.result}</span><p>{corrente.data.result}</p></div>
          <div class="case-block"><span class="label mono">{copy.lesson}</span><p>{corrente.data.lesson}</p></div>
          <a class="mono" href={getRelativeLocaleUrl(lang, `magazine/${magazineSlug(corrente)}`)}>{copy.permalink}</a>
        </div>
      </details>
    )}
  </div>

  {pilaArretrati.length > 0 && (
    <Newsstand head={copy.arretratiHead} items={pilaArretrati} newTab={copy.newTab} sameTab />
  )}

  {/* Testo del link e non il badge di dev.to: il marchio di un altro dentro questa
      pagina stona, ed è la stessa ragione per cui le certificazioni non usano i
      badge colorati di Credly (DESIGN.md). Il nome accessibile comincia col testo
      VISIBILE, perché chi comanda a voce dice quello che legge (WCAG 2.5.3). */}
  <Newsstand head={copy.edicolaHead} items={bylines} newTab={copy.newTab}>
    <a
      slot="fonte"
      class="fonte-edicola"
      href="https://dev.to/mk023"
      target="_blank"
      rel="noopener"
      aria-label={`dev.to/mk023 — ${copy.profilo} (${copy.newTab})`}
    >dev.to/mk023</a>
  </Newsstand>
</section>

<style>
  /* Come il `.src` della sezione Security: piccolo, sommesso, a destra della sua
     etichetta. Sotto il dito però quel corpo non basta come bersaglio, e il padding
     verticale lo porta a 44px senza gonfiare la riga col mouse. */
  .fonte-edicola{
    /* Quando la riga va a capo (etichetta lunga su schermo stretto) la fonte
       resterebbe a sinistra sotto l'etichetta, cioè di nuovo una riga orfana.
       `margin-left:auto` la tiene a destra anche lì. */
    margin-left:auto;
    font-size:11px; letter-spacing:0.06em;
    color:var(--ink); opacity:0.7;
    text-decoration-thickness:1.5px; text-underline-offset:4px;
    transition:opacity 0.15s ease, color 0.15s ease;
  }
  .fonte-edicola:hover{ opacity:1; color:var(--orange-text); }
  .fonte-edicola:focus-visible{ outline:3px solid var(--orange); outline-offset:3px; opacity:1; }
  /* 16 e non 13: 13px di corpo più 2x16 fanno 45px di bersaglio, sopra i 44
     raccomandati. Con 13 ne facevano 39, misurati — sotto la soglia. */
  @media (pointer:coarse){
    .fonte-edicola{ display:inline-block; padding:16px 0; }
  }
</style>

<script>
  // Count-up per la statistica del numero, appena la tile entra in viewport.
  // Query distinta (.mag-stat) per non collidere con .big-stat di Field Notes.
  // Nuovo numero al mese = aggiungi la coppia it/ + en/ in src/content/magazine/.
  document.querySelectorAll<HTMLElement>('.mag-stat[data-target]').forEach((el) => {
    const target = parseInt(el.dataset.target || '0', 10);
    const suffix = el.dataset.suffix || '';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = target + suffix;
      return;
    }

    let started = false;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            const duration = 1100;
            const startTime = performance.now();
            function tick(now: number) {
              const progress = Math.min((now - startTime) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = Math.round(eased * target) + suffix;
              if (progress < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );
    io.observe(el);
  });
</script>

