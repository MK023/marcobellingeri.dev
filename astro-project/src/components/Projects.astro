---
import { numeroSezione } from '../lib/sections';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

// Il badge-portale della card Atlas: la card racconta il grafo, il badge lo
// APRE — dentro lo scope del progetto, accanto al suo stato, non in fondo
// alla sezione. Vive fuori dal <button> del toggle (un link dentro un bottone
// è HTML invalido), nella riga dei chip.
const portali: Record<Lang, Record<string, { path: string; label: string }>> = {
  it: {
    'case-atlas': { path: 'atlas', label: 'IL GRAFO, LIVE →' },
    'case-agentic-os': { path: 'agentic-os', label: 'I NUMERI, LIVE →' },
  },
  en: {
    'case-atlas': { path: 'atlas', label: 'THE GRAPH, LIVE →' },
    'case-agentic-os': { path: 'agentic-os', label: 'THE NUMBERS, LIVE →' },
  },
};

type Project = {
  id: string;
  name: string;
  status: 'shipped' | 'active' | 'rnd';
  statusLabel: string;
  swatchClass: 'p-orange' | 'p-violet' | 'p-dark';
  summary: string;
  problem: string;
  approach: string;
  result: string;
};

// Nuovo progetto? Aggiungi un oggetto in entrambe le lingue — il markup si genera da solo.
const projects: Record<Lang, Project[]> = {
  it: [
    {
      id: 'case-llmcouncil',
      name: 'LLM Council',
      status: 'shipped',
      statusLabel: 'OPEN SOURCE',
      swatchClass: 'p-dark',
      summary:
        'Tre modelli di provider diversi messi a contraddirsi a vicenda, perché un LLM da solo tende a darti ragione. Rispondono separati, poi si valutano alla cieca, poi un presidente esterno tira le somme. Lo uso davvero, prima delle decisioni che pesano.',
      problem:
        'La compiacenza di un modello non si toglie col prompt: sta nei pesi, ci finisce durante l’addestramento. Un LLM usato come supporto alle decisioni conferma la direzione che gli segnali, anche quando è sbagliata.',
      approach:
        'Python solo libreria standard, zero dipendenze a runtime: niente superficie d’attacco sulla catena di fornitura. Tre voter indipendenti via OpenRouter con risposte anonimizzate, valutazione incrociata alla cieca, presidente scelto fuori dal gruppo dei voter così non può votarsi. Anthropic è escluso per principio: chi orchestra il council non vota nel council.',
      result:
        'Repo pubblico con licenza MIT, 33 test verdi su tre versioni di Python, mappatura completa della OWASP LLM Top 10 in SECURITY.md, con i punti fuori perimetro dichiarati e motivati.',
    },
    {
      id: 'case-torinoparking',
      name: 'TorinoParking',
      status: 'active',
      statusLabel: '→ APP STORE',
      swatchClass: 'p-orange',
      summary:
        "Torino, ora di punta: dove la lasci la macchina? Un'API che risponde in tempo reale, costruita security-first come se fosse in produzione da anni: FastAPI async, PostGIS per il geospaziale, Redis con ETag. Prossima fermata: App Store.",
      problem:
        "Sapere in tempo reale dove c'è posto a Torino significava saltare tra fonti diverse, senza un'unica API pulita e veloce da interrogare.",
      approach:
        'API security-first: FastAPI async su Python 3.12, PostgreSQL 16 + PostGIS per il geospaziale, Redis 7 con compressione e richieste condizionali ETag, HMAC-SHA256 sulle API key (zero plaintext), rate limiting sliding-window multi-tier.',
      result:
        '51 test tra unit, integration ed e2e con testcontainer, CI/CD e threat model documentato in SECURITY.md. Prossimo traguardo: portarla su Apple App Store come app nativa.',
    },
    {
      id: 'case-agentic-os',
      name: 'Agentic OS',
      status: 'active',
      statusLabel: 'LIVE',
      swatchClass: 'p-violet',
      summary:
        'Quanto lavoro faccio davvero con l’AI, misurato invece che raccontato. Claude Code manda la sua telemetria a un hub mio, cinque servizi dietro un tunnel, e in questa pagina tre numeri veri si aggiornano da soli.',
      problem:
        'Del lavoro assistito dall’AI si parla per aneddoti. Non sapevo quanto ne facessi, con quali modelli, a che costo, e nessuno strumento me lo diceva senza spedire le mie sessioni a qualcun altro.',
      approach:
        'OpenTelemetry da Claude Code verso un Collector che autentica l’ingest e applica una allow-list sulle label: ciò che non è dichiarato sicuro non diventa mai una metrica. Prometheus conserva, Grafana mostra dietro Cloudflare Access, e una status API espone esattamente tre numeri aggregati: nessuna query libera, nessun contenuto di sessione.',
      result:
        'In produzione su Railway dietro un Cloudflare Tunnel, con nessun servizio esposto su un dominio pubblico della piattaforma. La allow-list è nata da una misura, non da una lettura: la mia email vera arrivava come label di Prometheus, e la correzione ovvia perdeva dati in silenzio.',
    },
    {
      id: 'case-atlas',
      name: 'Atlas',
      status: 'rnd',
      statusLabel: 'R&D',
      swatchClass: 'p-dark',
      summary:
        "L'esperimento filosofico del lotto: un knowledge graph su Obsidian che si chiede come si costruiscono memoria e identità. Accantonato come prodotto, insostituibile come strumento di pensiero, e la versione SaaS con RAG è ancora sul tavolo.",
      problem:
        'Le note sparse non si parlavano tra loro: idee, letture, progetti finivano isolati invece di connettersi.',
      approach:
        'Un grafo di conoscenza personale su Obsidian, pensato non solo come archivio ma come domanda aperta su come memoria e identità si costruiscono nel tempo.',
      result:
        "Deprioritizzato come prodotto rispetto a ciò che stava spedendo, ma resta lo strumento di pensiero più usato, e l'idea di una versione SaaS con RAG resta sul tavolo.",
    },
  ],
  en: [
    {
      id: 'case-llmcouncil',
      name: 'LLM Council',
      status: 'shipped',
      statusLabel: 'OPEN SOURCE',
      swatchClass: 'p-dark',
      summary:
        'Three models from three different providers, set up to disagree with each other, because one LLM on its own tends to tell you what you want to hear. They answer separately, rank each other blind, then an outside chairman sums up. I use it before decisions that actually cost something.',
      problem:
        'A model’s eagerness to agree is not a prompting problem: it sits in the weights, put there during training. An LLM used for decision support will confirm whatever direction you signal, including the wrong one.',
      approach:
        'Python standard library only, zero runtime dependencies, so there is no supply chain attack surface. Three independent voters through OpenRouter with anonymised answers, blind cross-ranking, and a chairman picked from outside the voter pool so it cannot vote for itself. Anthropic is excluded on principle: whoever runs the council does not sit on it.',
      result:
        'Public repo under MIT, 33 tests green across three Python versions, a full mapping of the OWASP LLM Top 10 in SECURITY.md, with the out-of-scope items named and justified.',
    },
    {
      id: 'case-torinoparking',
      name: 'TorinoParking',
      status: 'active',
      statusLabel: '→ APP STORE',
      swatchClass: 'p-orange',
      summary:
        "Turin, rush hour: where do you leave the car? An API that answers in real time, built security-first as if it had been in production for years: async FastAPI, PostGIS for geospatial, Redis with ETags. Next stop: the App Store.",
      problem:
        "Knowing in real time where there's a free spot in Turin meant jumping between different sources, with no single clean, fast API to query.",
      approach:
        'Security-first API: async FastAPI on Python 3.12, PostgreSQL 16 + PostGIS for geospatial, Redis 7 with compression and conditional ETag requests, HMAC-SHA256 on API keys (zero plaintext), multi-tier sliding-window rate limiting.',
      result:
        '51 tests across unit, integration and e2e with testcontainers, CI/CD and a threat model documented in SECURITY.md. Next milestone: bringing it to the Apple App Store as a native app.',
    },
    {
      id: 'case-agentic-os',
      name: 'Agentic OS',
      status: 'active',
      statusLabel: 'LIVE',
      swatchClass: 'p-violet',
      summary:
        'How much work I actually do with AI, measured instead of claimed. Claude Code ships its telemetry to a hub of my own, five services behind a tunnel, and on this page three real numbers update by themselves.',
      problem:
        'AI-assisted work gets discussed in anecdotes. I had no idea how much of it I was doing, with which models, at what cost, and no tool would tell me without shipping my sessions to somebody else.',
      approach:
        'OpenTelemetry from Claude Code into a Collector that authenticates the ingest and applies an allow-list on labels: anything not declared safe never becomes a metric. Prometheus stores, Grafana displays behind Cloudflare Access, and a status API exposes exactly three aggregate numbers: no free-form queries, no session content.',
      result:
        'In production on Railway behind a Cloudflare Tunnel, with no service exposed on a public platform domain. The allow-list came from a measurement, not from a reading: my real email address was arriving as a Prometheus label, and the obvious fix silently lost data.',
    },
    {
      id: 'case-atlas',
      name: 'Atlas',
      status: 'rnd',
      statusLabel: 'R&D',
      swatchClass: 'p-dark',
      summary:
        "The philosophical experiment of the lot: an Obsidian knowledge graph asking how memory and identity get built over time. Shelved as a product, irreplaceable as a thinking tool, and the RAG-powered SaaS idea is still on the table.",
      problem:
        "Scattered notes didn't talk to each other: ideas, readings and projects ended up isolated instead of connected.",
      approach:
        'A personal knowledge graph on Obsidian, meant not just as an archive but as an open question about how memory and identity are built over time.',
      result:
        'Deprioritised as a product against whatever was actually shipping, but it remains the thinking tool I use most, and the idea of a SaaS version with RAG is still on the table.',
    },
  ],
};

const list = projects[lang];
const title = lang === 'en' ? 'Projects' : 'Progetti';
const labels = { problem: lang === 'en' ? 'PROBLEM' : 'PROBLEMA', approach: lang === 'en' ? 'APPROACH' : 'APPROCCIO', result: lang === 'en' ? 'RESULT' : 'RISULTATO' };
---

<section id="projects" class="reveal">
  <div class="section-head">
    <span class="num mono">{numeroSezione('projects')}</span>
    <h2 class="display">{title}</h2>
  </div>
  <div class="reviews reveal-stagger" data-details={t('proj.details')} data-close={t('proj.close')}>
    {list.map((p) => (
      <div class="review">
        <div class={`review-preview ${p.swatchClass}`} aria-hidden="true">
          <span class="swatch-label mono">{p.name.toUpperCase()}</span>
        </div>
        <button class="review-toggle" data-target={p.id} aria-expanded="false" aria-controls={p.id}>
          <h3>{p.name}</h3>
          <span class="review-chevron mono">{t('proj.details')}</span>
        </button>
        <div class="review-chips">
          <span class={`status ${p.status} mono`}>{p.statusLabel}</span>
          {portali[lang][p.id] && (
            <a class="review-portal mono" href={getRelativeLocaleUrl(lang, portali[lang][p.id].path)}>
              {portali[lang][p.id].label}
            </a>
          )}
        </div>
        <p>{p.summary}</p>
        <div class="review-detail" id={p.id}>
          <div class="case-block"><span class="label mono">{labels.problem}</span><p>{p.problem}</p></div>
          <div class="case-block"><span class="label mono">{labels.approach}</span><p>{p.approach}</p></div>
          <div class="case-block"><span class="label mono">{labels.result}</span><p>{p.result}</p></div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // ---- project case-study accordions ----
  (function projectAccordions() {
    const reviews = document.querySelector<HTMLElement>('.reviews');
    if (!reviews) return;
    const detailsLabel = reviews.dataset.details || '';
    const closeLabel = reviews.dataset.close || '';

    reviews.querySelectorAll<HTMLButtonElement>('.review-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const detail = document.getElementById(btn.dataset.target || '');
        if (!detail) return;
        const isOpen = detail.classList.contains('open');
        detail.classList.toggle('open', !isOpen);
        btn.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
        const chevron = btn.querySelector('.review-chevron');
        if (chevron) chevron.textContent = isOpen ? detailsLabel : closeLabel;
      });
    });
  })();
</script>
