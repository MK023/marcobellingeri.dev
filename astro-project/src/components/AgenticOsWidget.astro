---
// Agentic OS live: i tre numeri di oggi di Claude Code, letti same-origin da
// /api/agentic-status (il Worker tiene le credenziali, la CSP resta intatta).
//
// Fetch nel client, NON nel frontmatter: il sito è statico: un fetch qui girerebbe
// a build time e congelerebbe i numeri al momento del deploy — l'opposto di "live".
// Stessa scelta della pagina Radar.
//
// Stato base senza JS (e con l'hub spento): tre trattini. Il widget dichiara
// "non lo so", non finge uno zero.
interface Props { sessioni: string; token: string; costo: string; }
const { sessioni, token, costo } = Astro.props;
---

<div class="agentic-os" data-agentic-os>
  <dl class="agentic-os-cifre">
    <div><dt class="mono">{sessioni}</dt><dd class="big-stat display" data-campo="sessionsToday">—</dd></div>
    <div><dt class="mono">{token}</dt><dd class="big-stat display" data-campo="tokensToday">—</dd></div>
    <div><dt class="mono">{costo}</dt><dd class="big-stat display" data-campo="costUsdToday">—</dd></div>
  </dl>
</div>

<script>
  // textContent, mai innerHTML: i numeri arrivano dalla rete e la rete è input
  // non fidato anche quando l'origine è nostra.
  const formatta = (campo: string, valore: number | null) => {
    if (valore === null || valore === undefined) return '—';
    if (campo === 'costUsdToday') return `$${valore.toFixed(2)}`;
    return new Intl.NumberFormat(document.documentElement.lang || 'it').format(valore);
  };

  for (const box of document.querySelectorAll<HTMLElement>('[data-agentic-os]')) {
    fetch('/api/agentic-status')
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((dati: Record<string, number | null>) => {
        for (const cella of box.querySelectorAll<HTMLElement>('[data-campo]')) {
          const campo = cella.dataset.campo!;
          cella.textContent = formatta(campo, dati[campo]);
        }
      })
      // I trattini sono già in pagina: un hub giù non lascia niente da fare qui.
      .catch(() => {});
  }
</script>

<style>
  /* Riquadro come .atl-frame: bordo netto e superficie incassata, il modo in cui
     questo sito incornicia un blocco di dati. */
  .agentic-os{
    border:2px solid var(--rule);
    background:var(--paper-dark);
    padding:20px 24px 24px;
  }
  /* Tre celle uguali, contenuto centrato in ciascuna. Le larghezze reali sono
     molto diverse ("5" contro otto cifre): distribuirle con space-between mette
     spazi disuguali e la riga sembra capitata lì. Con celle uguali il ritmo è
     sempre lo stesso, qualunque numero arrivi dall'hub. */
  .agentic-os-cifre{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:18px;
    margin:0;
  }
  .agentic-os-cifre > div{ text-align:center; }
  /* Il margine è generoso perché .big-stat ha line-height 0.8: con meno spazio
     l'etichetta finisce addosso alla cifra. Visto nel browser, non nel CSS. */
  .agentic-os-cifre dt{
    font-size:11px; letter-spacing:0.08em; text-transform:uppercase;
    opacity:0.7; margin-bottom:10px;
  }
  /* .big-stat porta identità e tratto, ma il suo clamp arriva a 120px: tre numeri
     affiancati, uno dei quali a otto cifre, non ci starebbero. Si riduce la sola
     dimensione e si tiene tutto il resto. */
  .agentic-os-cifre dd{
    margin:0;
    font-size:clamp(30px, 6vw, 58px);
  }
</style>
