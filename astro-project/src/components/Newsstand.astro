---
// Pila da edicola riusabile: le voci impilate come giornali, sfalsate e ruotate,
// che si aprono a ventaglio su hover / focus da tastiera / tap (mobile). Usata sia
// dall'Edicola (firme esterne) sia dalle Certificazioni. Data-driven: una voce =
// un oggetto in `items`. Solo link in uscita (nuova scheda).
// `sameTab`: la pila nasce per le firme in uscita, ma i numeri arretrati del
// magazine stanno in casa e una nuova scheda per restare sul sito è rumore.
// Opzionale e default false: i due chiamanti storici non cambiano di una virgola.
// Vale anche per singola voce (Item.sameTab): l'Edicola mescola firme esterne e
// pagine interne nella stessa pila, e interno/esterno è una proprietà della
// voce, non della pila.
interface Item { label: string; sub: string; href: string; sameTab?: boolean }
interface Props { head: string; items: Item[]; newTab: string; sameTab?: boolean }
const { head, items, newTab, sameTab = false } = Astro.props;
---

<div class="newsstand">
  <p class="certs-head mono">{head}</p>
  {/* Stato base (senza JS): riga a capo, ogni link raggiungibile — fallback
      accessibile. Lo <script> aggiunge .is-enhanced e la collassa in pila. */}
  <div class="newsstand-stack" data-newsstand>
    {items.map((b) => {
      const inCasa = sameTab || b.sameTab;
      return (
        <a
          class="paper"
          href={b.href}
          target={inCasa ? undefined : '_blank'}
          rel={inCasa ? undefined : 'noopener'}
          aria-label={inCasa ? `${b.label} — ${b.sub}` : `${b.label} — ${b.sub} (${newTab})`}
          title={b.label}
        >
          <span class="paper-source mono">{b.sub}</span>
          <span class="paper-title">{b.label}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  import { geometriaColonna, geometriaPila } from '../lib/pila';

  // Progressive enhancement. querySelectorAll (non querySelector): la pila può
  // comparire più volte nella pagina (Edicola + Certificazioni) e lo <script> del
  // componente gira una volta sola — deve potenziarle tutte.
  // Riserva l'altezza solo dove il ventaglio si apre passandoci SOPRA: lì il
  // movimento non lo chiede nessuno, e la sezione sotto non deve saltare. Col dito
  // l'apertura è un tap voluto, e riservare le righe vuote costerebbe schermate
  // bianche — quello spostamento resta, com'era già.
  // Qui prima c'era anche un `min-width:761px`, e serviva a evitare di misurare
  // dove il layout aperto non era quello pre-enhance. Non è più la larghezza a
  // dirlo: lo stato base è `wrap` a qualunque larghezza, quindi COINCIDE con
  // l'aperto — tranne quando la pila è verticale, dove l'aperto è una colonna. La
  // condizione vera è quella, e ora si legge dalla misura invece che da un numero.
  const hoverFine = window.matchMedia('(hover:hover) and (pointer:fine)');
  document.querySelectorAll<HTMLElement>('[data-newsstand]').forEach((stack) => {
    // Riserva l'altezza del ventaglio APERTO prima di collassare: lo stato senza
    // .is-enhanced è già il layout aperto (wrap), quindi basta misurarlo. Così
    // l'hover non sposta la sezione sotto. Su touch riservare le righe vuote
    // costerebbe schermate bianche. Tutto sincrono nello stesso frame: niente flash.
    //
    // La riserva sta sul CONTENITORE, non sulla pila, e non è un dettaglio: messa
    // sulla pila le dava una scatola alta quanto il ventaglio aperto mentre i fogli
    // ne occupavano un terzo — 264px contro 82 sulle Certificazioni. Il resto era
    // area invisibile che continuava a valere come `:hover`, quindi la pila restava
    // aperta col puntatore visibilmente lontano, e a chiuderla era solo l'uscita
    // dalla banda vuota. Sul contenitore lo spazio è riservato lo stesso, ma la
    // pila torna alta quanto i suoi fogli.
    const contenitore = stack.parentElement as HTMLElement;
    // Lo sfalso non è più una costante nel CSS: la pila non ha un numero fisso di
    // voci — l'Edicola la riempie il cron (engine/edicola.mjs) ed è passata da 8 a
    // 12 senza che nessuno ritoccasse quel numero. Con 12 fogli la riga misurava
    // 1106px, più larga di ogni iPad, e la pagina scorreva in orizzontale. Qui si
    // misurano i pezzi e il conto lo fa src/lib/pila.ts, che è la sola parte
    // provabile senza un browser (test/pila.test.mjs).
    const misura = () => {
      const fogli = [...stack.querySelectorAll<HTMLElement>('.paper')];
      const cs = getComputedStyle(stack);
      const larghezza = geometriaPila({
        n: fogli.length,
        foglio: fogli[0]?.offsetWidth ?? 0,
        // Niente `|| 0` qui: su un elemento non reso `columnGap` è la stringa vuota
        // e parseFloat dà NaN. Trasformarlo in zero lo rende finito, quindi la
        // guardia in pila.ts non scatta più e il conto esce sbagliato di un gap
        // per foglio — 154px di sbordo con 12 voci, cioè il difetto di partenza.
        // Un NaN qui è la verità: la misura non c'è, e va gestita di là.
        gap: parseFloat(cs.columnGap),
        padding: parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight),
        disponibile: (stack.parentElement as HTMLElement).clientWidth,
      });
      // Le altezze si leggono nello stato APERTO, che è quello in cui questa
      // funzione gira (riserva() misura prima di collassare): lì ogni foglio è
      // alto quanto il suo titolo, e sono quelle le altezze che la colonna somma.
      const altezze = fogli.map((f) => f.offsetHeight);
      const colonna = geometriaColonna({
        n: fogli.length,
        somma: altezze.reduce((a, h) => a + h, 0),
        minima: altezze.length ? Math.min(...altezze) : 0,
        gap: parseFloat(cs.rowGap),
      });
      return { ...larghezza, sfalsoColonna: colonna.sfalso };
    };

    const riserva = () => {
      const { sfalso, verticale, sfalsoColonna } = misura();
      stack.style.setProperty('--sfalso', `-${sfalso}px`);
      stack.style.setProperty('--sfalso-colonna', `-${sfalsoColonna}px`);
      stack.classList.toggle('is-vertical', verticale);
      stack.classList.add('no-anim');
      if (hoverFine.matches && !verticale) {
        stack.classList.remove('is-enhanced');
        contenitore.style.minHeight = '';
        contenitore.style.minHeight = `${contenitore.offsetHeight}px`;
      } else {
        // niente misura (e niente doppio reflow) dove non serve: su mobile il
        // resize scatta a ogni comparsa della barra URL durante lo scroll. La
        // riserva si toglie da entrambi: la pila la portava nelle versioni
        // precedenti, e una pagina aperta mentre si passa da mouse a dito se la
        // ritroverebbe addosso.
        contenitore.style.minHeight = '';
        stack.style.minHeight = '';
      }
      stack.classList.add('is-enhanced');
      void stack.offsetHeight; // reflow: separa il collasso dalla riattivazione delle transizioni
      stack.classList.remove('no-anim');
    };
    riserva();
    let raf = 0;
    const rimisura = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(riserva);
    };
    window.addEventListener('resize', rimisura);
    // La prima misura può avvenire coi font di fallback: al swap le altezze
    // cambiano. E il mouse può comparire dopo (iPad + trackpad).
    document.fonts?.ready.then(rimisura);
    hoverFine.addEventListener?.('change', rimisura);

    // Ventaglio da tastiera: si apre solo col focus VISIBILE (:focus-visible),
    // riusando .is-open. Niente :focus-within in CSS: dopo un click su un link
    // target=_blank il focus resta sul foglio e terrebbe la pila aperta per sempre.
    stack.addEventListener('focusin', (e) => {
      const t = e.target as HTMLElement;
      try {
        if (t.matches(':focus-visible')) stack.classList.add('is-open');
      } catch {
        // Safari < 15.4 (niente :focus-visible): meglio il vecchio comportamento
        // "apri su qualsiasi focus" che una tastiera senza ventaglio.
        stack.classList.add('is-open');
      }
    });
    stack.addEventListener('focusout', (e) => {
      if (!stack.contains(e.relatedTarget as Node)) stack.classList.remove('is-open');
    });

    // Il tipo di puntatore dell'ultima interazione decide se intercettare il tap.
    // Tastiera/mouse non vengono intercettati: ci pensano .is-open e :hover.
    let lastPointerType = '';
    stack.addEventListener('pointerdown', (e) => { lastPointerType = (e as PointerEvent).pointerType; }, true);
    stack.addEventListener('keydown', () => { lastPointerType = 'key'; }, true);

    // Su touch il PRIMO tap apre il ventaglio invece di seguire il link: i fogli
    // sotto diventano raggiungibili. Il secondo tap naviga. Un tap fuori richiude.
    stack.addEventListener('click', (e) => {
      if (stack.classList.contains('is-open')) return;
      if (lastPointerType !== 'touch' && lastPointerType !== 'pen') return;
      if (!(e.target as HTMLElement).closest('a')) return;
      e.preventDefault();
      stack.classList.add('is-open');
    });
    document.addEventListener('click', (e) => {
      if (!stack.contains(e.target as Node)) stack.classList.remove('is-open');
    });
  });
</script>

<style>
  /* Scoped: Astro ne hasha lo stile nella CSP (niente style="" inline). Tutto su
     var(--ink/--paper) → giorno e notte. */
  .newsstand{ margin-top:34px; }

  .newsstand-stack{
    display:flex; flex-wrap:wrap; align-items:flex-start;
    gap:14px; padding:6px 4px 12px;
  }

  .paper{
    position:relative; display:flex; flex-direction:column; gap:6px;
    flex:0 0 auto; width:min(240px, 78vw);
    padding:11px 14px 13px;
    text-decoration:none; color:var(--ink); background:var(--paper);
    border:2px solid var(--ink); box-shadow:4px 4px 0 var(--ink);
    /* Più lento e con easing ease-out morbido: l'apertura respira invece di
       scattare. margin/transform separati dal resto (colore/ombra restano rapidi). */
    transition:margin 0.45s cubic-bezier(.22,.61,.36,1),
               transform 0.45s cubic-bezier(.22,.61,.36,1),
               box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .paper-source{
    font-family:'JetBrains Mono', monospace;
    font-size:10px; letter-spacing:0.12em; text-transform:uppercase;
    opacity:0.62; padding-bottom:5px; border-bottom:1.5px solid var(--ink);
  }
  /* Tre righe e poi taglia: il titolo di un numero arretrato ne riempiva cinque e
     il foglio cresceva del 50% rispetto agli altri della pila. In edicola si legge
     l'inizio del titolo, non tutto. Le certificazioni oggi stanno nelle tre righe;
     se un titolo futuro sborda, il testo intero resta nel title= del foglio
     (tooltip) oltre che nell'aria-label. */
  .paper-title{
    font-family:'Source Serif 4', serif;
    font-size:16px; font-weight:600; line-height:1.25;
    display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical;
    overflow:hidden;
  }
  /* :hover e :focus-visible in regole SEPARATE: un browser senza :focus-visible
     (Safari ≤ 15.3) butta l'intera lista di selettori, e con la virgola
     perderebbe anche l'hover. */
  .paper:hover{
    background:var(--ink); color:var(--paper);
    box-shadow:6px 6px 0 var(--orange);
  }
  .paper:focus-visible{
    background:var(--ink); color:var(--paper);
    box-shadow:6px 6px 0 var(--orange);
  }
  .paper:hover .paper-source{ opacity:0.85; border-bottom-color:var(--paper); }
  .paper:focus-visible .paper-source{ opacity:0.85; border-bottom-color:var(--paper); }
  .paper:focus-visible{ outline:3px solid var(--orange); outline-offset:3px; }

  /* Pila (JS presente): riga singola che si sovrappone marciando verso destra.
     Overlap FISSO in px (non %: la % è relativa al contenitore e con molte voci
     spinge i fogli fuori dallo schermo a sinistra). Ogni foglio mostra ~65px. */
  /* fit-content: la zona che apre in hover è la pila, non tutta la riga vuota
     a destra. Da aperto (wrap) fit-content torna a valere la larghezza piena. */
  /* contain:layout — il ventaglio anima `margin` (proprietà di LAYOUT) su fino a 8
     fogli per ~0.65s: senza confine ogni frame fa risalire il reflow a tutto il
     documento (è lo scatto). Qui lo isola al sottoalbero della pila; l'altezza è già
     riservata (minHeight via script) quindi conterla non muove nulla intorno. Solo
     `layout`: `paint` cliperebbe rotazioni e ombre dei fogli. */
  .newsstand-stack.is-enhanced{ flex-wrap:nowrap; width:fit-content; contain:layout; }
  .newsstand-stack.is-enhanced .paper:not(:first-child){ margin-left:var(--sfalso, -176px); }
  .newsstand-stack.is-enhanced .paper:nth-child(4n+1){ transform:rotate(-2.2deg) translateY(2px); }
  .newsstand-stack.is-enhanced .paper:nth-child(4n+2){ transform:rotate(1.6deg)  translateY(-1px); }
  .newsstand-stack.is-enhanced .paper:nth-child(4n+3){ transform:rotate(-1deg)   translateY(1px); }
  .newsstand-stack.is-enhanced .paper:nth-child(4n+4){ transform:rotate(2deg)    translateY(-2px); }

  /* Durante la misura dell'altezza riservata (script) le transizioni sono spente:
     il collasso iniziale e le ri-misure su resize scattano senza animare. */
  .newsstand-stack.no-anim .paper{ transition:none; }

  /* Ventaglio: si torna alla riga. L'apertura è a CASCATA (transition-delay sui
     figli successivi) così i fogli si aprono uno dopo l'altro, non tutti insieme:
     è quello che la fa sembrare naturale. In chiusura il delay non c'è → richiude
     svelta. */
  /* Ventaglio: la riga torna a capo (wrap) così tutti i fogli sono raggiungibili
     anche quando la pila era più larga dello schermo. Niente :focus-within: il
     focus da click (link target=_blank) terrebbe la pila aperta anche a cursore
     lontano — il focus da tastiera passa da .is-open, messo dallo script solo
     su :focus-visible. */
  .newsstand-stack.is-enhanced:hover,
  .newsstand-stack.is-enhanced.is-open{ flex-wrap:wrap; }
  .newsstand-stack.is-enhanced:hover .paper,
  .newsstand-stack.is-enhanced.is-open .paper{ margin-left:0; transform:rotate(0); }

  .newsstand-stack.is-enhanced:hover .paper:nth-child(2),
  .newsstand-stack.is-enhanced.is-open .paper:nth-child(2){ transition-delay:0.04s; }
  .newsstand-stack.is-enhanced:hover .paper:nth-child(3),
  .newsstand-stack.is-enhanced.is-open .paper:nth-child(3){ transition-delay:0.08s; }
  .newsstand-stack.is-enhanced:hover .paper:nth-child(4),
  .newsstand-stack.is-enhanced.is-open .paper:nth-child(4){ transition-delay:0.12s; }
  .newsstand-stack.is-enhanced:hover .paper:nth-child(5),
  .newsstand-stack.is-enhanced.is-open .paper:nth-child(5){ transition-delay:0.16s; }
  .newsstand-stack.is-enhanced:hover .paper:nth-child(n+6),
  .newsstand-stack.is-enhanced.is-open .paper:nth-child(n+6){ transition-delay:0.2s; }

  /* Dove nemmeno stringendo la riga ci sta, la pila si impila in VERTICALE, come
     giornali visti di fronte: resta il taglio da edicola, resta il tap per aprire.
     Prima era una media query a 760px, cioè un numero tarato su una pila di otto
     voci; ora la scelta la fa la misura, perché a decidere non è la larghezza
     dello schermo ma il rapporto fra quella e quante voci ci sono dentro. Con 12
     fogli su un iPad da 834px la riga ci sta ancora, stringendo; su un telefono no,
     e infatti lì la classe la mette lo script. */
  .newsstand-stack.is-enhanced.is-vertical{ flex-direction:column; flex-wrap:nowrap; }
  /* Anche la colonna si stringe da sola, con la stessa regola della larghezza:
     resta com'è finché sta nel budget (520px: con le 12 voci di oggi ne misura 490
     su un iPhone, quindi oggi non cambia niente), poi sovrappone di più.
     ponytail: il tetto qui è morbido, non assoluto. I fogli non sono alti uguale —
     il titolo è tagliato a tre righe, quindi vanno da 77 a 135px — e la
     sovrapposizione toglie gli stessi pixel a tutti: per far stare 40 voci in
     520px il foglio più basso dovrebbe sparire. La crescita per voce scende da
     ~40px a ~20 e lì si ferma; se servisse il tetto duro, la leva è il numero di
     righe del titolo, non questa. */
  .newsstand-stack.is-enhanced.is-vertical .paper:not(:first-child){ margin-left:0; margin-top:var(--sfalso-colonna, -58px); }
  .newsstand-stack.is-enhanced.is-vertical:hover .paper,
  .newsstand-stack.is-enhanced.is-vertical.is-open .paper{ margin-top:0; }

  /* Reduced motion: niente pila né rotazioni, resta la riga leggibile.
     `.is-vertical` va NOMINATA, non sottintesa. Prima la variante verticale viveva
     in una media query e pareggiava la specificità con questa deroga, che stando
     più in basso vinceva; ora porta una classe in più e vincerebbe lei. Chi ha
     chiesto meno movimento si ritroverebbe la colonna con i fogli sovrapposti di
     58px — cioè proprio la pila, dove questa riga promette di non dargliela. */
  @media (prefers-reduced-motion: reduce){
    .paper{ transition:box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease; }
    .newsstand-stack.is-enhanced .paper,
    .newsstand-stack.is-enhanced .paper:not(:first-child),
    .newsstand-stack.is-enhanced.is-vertical .paper,
    .newsstand-stack.is-enhanced.is-vertical .paper:not(:first-child){ margin:0; transform:none; }
  }
</style>
