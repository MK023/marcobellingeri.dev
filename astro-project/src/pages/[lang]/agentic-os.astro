---
import type { Lang } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UtilityBar from '../../components/UtilityBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AgenticOsWidget from '../../components/AgenticOsWidget.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

// Il portale della card Agentic OS, stessa forma di atlas.astro: la card racconta
// l'hub, questa pagina lo mostra. I numeri non si renderizzano qui, perché il sito
// è statico e un fetch nel frontmatter li congelerebbe al deploy. Li prende il
// widget nel client, same-origin da /api/agentic-status.
//
// Impaginazione e classi vengono da global.css e da atlas.astro, non da un foglio
// nuovo: .certs-head per la sopra-testata, .display per il titolo, .case-block con
// .label mono per le note, .util-btn per il ritorno. Lo scoped qui sotto contiene
// solo ciò che non esiste già.
const copy = {
  it: {
    title: 'Agentic OS, i numeri di oggi',
    h1: 'I numeri di oggi',
    tagline: "Quanto lavoro faccio con l'AI, misurato dal mio hub invece che raccontato.",
    intro:
      'Claude Code gira sul mio computer e manda la sua telemetria a un hub che ho costruito: Collector, Prometheus, Grafana e una piccola API, cinque servizi su Railway dietro un Cloudflare Tunnel. I tre numeri qui sotto arrivano da lì mentre leggi.',
    widget: {
      sessioni: 'Sessioni', token: 'Token', costo: 'Costo',
      vecchi: 'Numeri di circa {n} min fa: l’hub non risponde in questo momento',
    },
    finestraH: 'PERCHÉ 25 ORE E NON "OGGI"',
    finestra:
      'Ogni sessione è una serie a sé: un contatore che cresce finché la sessione vive, e poi resta fermo. Per sommarli chiedo all\'archivio il valore più alto che ogni serie ha toccato nelle ultime venticinque ore. Un contatore non torna indietro, quindi quel massimo è il totale di quella sessione. Chiederlo invece al Collector, che dopo un po\' smette di esporre una serie, sembrava equivalente e non lo era: a ogni suo riavvio le sessioni già chiuse sparivano dal conto. Non è un giorno di calendario, è l\'attività delle ultime venticinque ore circa. Tanto quanto questi numeri possono dire senza barare.',
    confineH: 'COSA NON ESCE DA QUI',
    confine:
      "Tre numeri aggregati, e basta. Nessun prompt, nessuna risposta, nessuna query libera sul database delle metriche. L'identità non arriva nemmeno all'archivio, perché il Collector tiene una allow-list sulle label: un attributo che nessuno ha dichiarato sicuro viene scartato per difetto, invece di essere cancellato dopo. La scelta nasce da una misura, non da una lettura. La mia email vera arrivava come label di Prometheus, e la correzione ovvia perdeva dati senza dirlo.",
    trattiniH: 'SE VEDI TRE TRATTINI',
    trattini:
      "L'hub non ha risposto. Preferisco dire che non lo so, piuttosto che mostrare uno zero che sembrerebbe una risposta.",
    back: 'Torna ai progetti',
  },
  en: {
    title: 'Agentic OS, today’s numbers',
    h1: 'Today’s numbers',
    tagline: 'How much work I do with AI, measured by my own hub instead of claimed.',
    intro:
      'Claude Code runs on my machine and sends its telemetry to a hub I built: Collector, Prometheus, Grafana and a small API, five services on Railway behind a Cloudflare Tunnel. The three numbers below come from there while you read this.',
    widget: {
      sessioni: 'Sessions', token: 'Tokens', costo: 'Cost',
      vecchi: 'Numbers from about {n} min ago: the hub is not answering right now',
    },
    finestraH: 'WHY 25 HOURS AND NOT "TODAY"',
    finestra:
      'Every session is its own series: a counter that grows while the session lives, then stops. To add them up I ask the archive for the highest value each series reached in the last twenty five hours. A counter never goes backwards, so that maximum is the session’s total. Asking the Collector instead, which stops exposing a series after a while, looked equivalent and was not: every time it restarted, the sessions that had already ended dropped out of the count. This is not a calendar day, it is roughly the last twenty five hours of activity. As much as these numbers can claim without cheating.',
    confineH: 'WHAT DOES NOT LEAVE THIS HUB',
    confine:
      'Three aggregate numbers, and nothing else. No prompts, no answers, no free-form queries against the metrics database. Identity never even reaches storage, because the Collector keeps an allow-list on labels: an attribute nobody declared safe is dropped by default, rather than deleted afterwards. That choice came from a measurement, not from a reading. My real email address was arriving as a Prometheus label, and the obvious fix lost data without saying so.',
    trattiniH: 'IF YOU SEE THREE DASHES',
    trattini:
      'The hub did not answer. I would rather say I do not know than show a zero, which would look like an answer.',
    back: 'Back to projects',
  },
}[lang];

// Ancora #projects e non la radice: a questa pagina si arriva dal chip nella card
// dei Progetti, quindi il ritorno deve rimettere il lettore dov'era. Riportarlo in
// cima alla home gli fa riscorrere tutto per ritrovare il punto da cui è partito.
const backHref = `${getRelativeLocaleUrl(lang, '')}#projects`;
---

<BaseLayout lang={lang} title={copy.title} description={copy.tagline} path="agentic-os">
  <UtilityBar />
  <main id="main-content">
    <article class="ao-wrap">
      <p class="certs-head mono">AGENTIC OS</p>
      <h1 class="display ao-title">{copy.h1}</h1>
      <p class="ao-intro">{copy.intro}</p>

      <AgenticOsWidget
        sessioni={copy.widget.sessioni}
        token={copy.widget.token}
        costo={copy.widget.costo}
        vecchi={copy.widget.vecchi}
      />

      <div class="ao-note">
        <div class="case-block">
          <span class="label mono">{copy.finestraH}</span>
          <p>{copy.finestra}</p>
        </div>
        <div class="case-block">
          <span class="label mono">{copy.confineH}</span>
          <p>{copy.confine}</p>
        </div>
        <div class="case-block">
          <span class="label mono">{copy.trattiniH}</span>
          <p>{copy.trattini}</p>
        </div>
      </div>

      <a class="util-btn ao-back" href={backHref}>← {copy.back}</a>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Stesse misure di atlas.astro: le pagine dedicate hanno già una forma. */
  .ao-wrap{ max-width:960px; margin:0 auto; padding:56px 24px 48px; }
  .ao-title{ font-size:clamp(28px, 5.5vw, 48px); line-height:0.98; margin:0 0 16px; }
  .ao-intro{ font-size:16px; line-height:1.65; max-width:640px; margin:0 0 28px; }
  .ao-note{ margin-top:36px; max-width:640px; }
  .ao-note p{ font-size:15px; line-height:1.7; margin:0; }
  /* Come .atl-back: senza questo il link eredita il sottolineato del browser,
     che .util-btn da solo non toglie. */
  .ao-back{ display:inline-block; margin-top:36px; text-decoration:none; }
</style>
