---
import type { Lang } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UtilityBar from '../../components/UtilityBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AgenticOsWidget from '../../components/AgenticOsWidget.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

// Il portale della card Agentic OS, stessa forma di atlas.astro: la card racconta
// l'hub, questa pagina lo MOSTRA. I numeri non sono renderizzati qui — il sito è
// statico e un fetch nel frontmatter li congelerebbe al momento del deploy. Li
// prende il widget nel client, same-origin da /api/agentic-status.
const copy = {
  it: {
    title: 'Agentic OS — i numeri di oggi',
    tagline: "L'osservabilità del mio lavoro con l'AI, in tre numeri che non scrivo io.",
    intro:
      'Claude Code, sul mio computer, esporta telemetria OpenTelemetry verso un hub che ho costruito: Collector, Prometheus, Grafana e una piccola API, cinque servizi su Railway dietro un Cloudflare Tunnel. Questi tre numeri arrivano da lì, adesso.',
    widget: { head: 'ULTIME ~25 ORE', sessioni: 'Sessioni', token: 'Token', costo: 'Costo' },
    finestraH: 'Perché “~25 ore” e non “oggi”',
    finestra:
      'Ogni sessione è una serie a sé, un contatore che cresce finché la sessione vive e poi resta fermo per sempre. La finestra la dà il Collector, che smette di esporre una serie un giorno dopo il suo ultimo aggiornamento. Quindi non è un giorno di calendario: è l’attività delle ultime venticinque ore circa, che è ciò che questi numeri sanno dire onestamente.',
    confineH: 'Cosa non esce di qui',
    confine:
      'Escono tre numeri aggregati e nient’altro: nessun prompt, nessuna risposta, nessuna query libera sul database delle metriche. L’identità non arriva nemmeno all’archivio — il Collector tiene una allow-list sulle label, così un attributo che nessuno ha dichiarato sicuro viene scartato per difetto invece di essere cancellato dopo. È una scelta nata da una misura, non da una lettura: la mia email vera arrivava come label di Prometheus, e la correzione ovvia perdeva dati in silenzio.',
    trattiniH: 'Se vedi tre trattini',
    trattini:
      'Vuol dire che l’hub non ha risposto. Preferisco dichiarare che non lo so, invece di mostrare uno zero che sembra una risposta.',
    back: 'Torna alla home',
  },
  en: {
    title: 'Agentic OS — today’s numbers',
    tagline: 'Observability of my own AI-assisted work, in three numbers I do not write.',
    intro:
      'Claude Code, on my machine, exports OpenTelemetry data to a hub I built: Collector, Prometheus, Grafana and a small API, five services on Railway behind a Cloudflare Tunnel. These three numbers come from there, right now.',
    widget: { head: 'LAST ~25 HOURS', sessioni: 'Sessions', token: 'Tokens', costo: 'Cost' },
    finestraH: 'Why “~25 hours” and not “today”',
    finestra:
      'Each session is its own series, a counter that grows while the session lives and then stays flat forever. The window comes from the Collector, which stops exposing a series a day after its last update. So this is not a calendar day: it is roughly the last twenty-five hours of activity, which is what these numbers can honestly claim.',
    confineH: 'What does not leave the hub',
    confine:
      'Three aggregate numbers and nothing else: no prompts, no answers, no free-form queries against the metrics database. Identity never even reaches storage — the Collector keeps an allow-list on labels, so an attribute nobody declared safe is dropped by default rather than deleted afterwards. That choice came from a measurement, not from a reading: my real email address was arriving as a Prometheus label, and the obvious fix silently lost data.',
    trattiniH: 'If you see three dashes',
    trattini:
      'It means the hub did not answer. I would rather say I do not know than show a zero that looks like an answer.',
    back: 'Back to home',
  },
}[lang];

const backHref = getRelativeLocaleUrl(lang, '');
---

<BaseLayout lang={lang} title={copy.title} description={copy.tagline} path="agentic-os">
  <UtilityBar />
  <main id="main-content">
    <article class="ao-wrap">
      <p class="ao-cred mono">AGENTIC OS</p>
      <h1 class="ao-title">{copy.title}</h1>
      <p class="ao-intro">{copy.intro}</p>

      <AgenticOsWidget
        head={copy.widget.head}
        sessioni={copy.widget.sessioni}
        token={copy.widget.token}
        costo={copy.widget.costo}
      />

      <section class="ao-nota">
        <h2>{copy.finestraH}</h2>
        <p>{copy.finestra}</p>
      </section>

      <section class="ao-nota">
        <h2>{copy.confineH}</h2>
        <p>{copy.confine}</p>
      </section>

      <section class="ao-nota">
        <h2>{copy.trattiniH}</h2>
        <p>{copy.trattini}</p>
      </section>

      <a class="util-btn ao-back" href={backHref}>← {copy.back}</a>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Solo impaginazione: i colori stanno nei token di global.css, qui non se ne
     inventano (DESIGN.md). */
  .ao-wrap {
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .ao-cred {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    opacity: 0.7;
    margin: 0 0 0.5rem;
  }
  .ao-title {
    margin: 0 0 0.75rem;
  }
  .ao-intro {
    margin: 0 0 2rem;
  }
  .ao-nota {
    margin-top: 2.5rem;
  }
  .ao-nota h2 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }
  .ao-nota p {
    margin: 0;
  }
  .ao-back {
    display: inline-block;
    margin-top: 3rem;
  }
</style>
