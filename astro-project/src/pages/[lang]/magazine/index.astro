---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UtilityBar from '../../../components/UtilityBar.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ArchiveIndex from '../../../components/ArchiveIndex.astro';
import { magazineSlug, tronca } from '../../../lib/magazine';
import { ldJson } from '../../../lib/jsonld';
import type { Lang } from '../../../i18n/ui';

// Stessa ragione dell'indice degli articoli: /it/magazine era un segmento di URL
// senza pagina, mentre /it/magazine/<slug> rispondeva. Qui la pila degli arretrati
// diventa una lista leggibile anche senza JS e senza passare dalla home.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

const numeri = (await getCollection('magazine', (m) => m.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const copy = {
  it: {
    title: 'Magazine',
    head: 'ARCHIVIO · TUTTI I NUMERI',
    intro: 'Un numero al mese su IA, sicurezza e governance sul lavoro: il problema, la scelta fatta, cosa è cambiato. Lo scrive una pipeline, verificato sulle fonti e revisionato da una persona prima di uscire.',
    back: 'Torna alla home',
    aiLabel: 'Generato con IA, revisionato da una persona',
  },
  en: {
    title: 'Magazine',
    head: 'ARCHIVE · EVERY ISSUE',
    intro: 'One issue a month on AI, security and governance at work: the problem, the call made, what changed. A pipeline writes it, checked against the sources and reviewed by a person before it ships.',
    back: 'Back to home',
    aiLabel: 'AI-generated, human-reviewed',
  },
}[lang];

const voci = numeri.map((n) => ({
  href: getRelativeLocaleUrl(lang, `magazine/${magazineSlug(n)}`),
  titolo: n.data.title,
  etichetta: `N.${String(n.data.number).padStart(2, '0')} · ${n.data.month.toUpperCase()} · ${n.data.sector}`,
  datetime: n.data.date.toISOString().slice(0, 10),
  sotto: tronca(n.data.problem, 200),
}));

const listaLd = ldJson({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: voci.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(v.href, Astro.site).href,
    name: v.titolo,
  })),
});

// L'etichetta art. 50 AI Act sta su ogni numero: sta anche sull'elenco che li
// raccoglie, con lo stesso link alla pagina di trasparenza.
const aiUrl = getRelativeLocaleUrl(lang, 'ai');
---

<BaseLayout lang={lang} title={`${copy.title} — Bellingeri`} description={copy.intro} path="magazine">
  <script type="application/ld+json" set:html={listaLd} slot="head" />
  <UtilityBar />
  <main id="main-content">
    <ArchiveIndex
      head={copy.head}
      titolo={copy.title}
      intro={copy.intro}
      voci={voci}
      back={{ href: getRelativeLocaleUrl(lang, ''), label: copy.back }}
      ai={{ href: aiUrl, label: copy.aiLabel }}
    />
  </main>
  <SiteFooter />
</BaseLayout>
