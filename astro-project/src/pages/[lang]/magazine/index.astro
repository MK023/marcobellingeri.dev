---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UtilityBar from '../../../components/UtilityBar.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { magazineSlug } from '../../../lib/magazine';
import type { Lang } from '../../../i18n/ui';

// Stessa ragione dell'indice degli articoli: /it/magazine era un segmento di URL
// senza pagina, mentre /it/magazine/<slug> rispondeva. Qui la pila degli arretrati
// diventa una lista leggibile anche senza JS e senza passare dalla home.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

const numeri = (await getCollection('magazine', (m) => m.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const copy = {
  it: {
    title: 'Magazine',
    head: 'ARCHIVIO · TUTTI I NUMERI',
    intro: 'Un numero al mese su IA, sicurezza e governance sul lavoro: il problema, la scelta fatta, cosa è cambiato. Lo scrive una pipeline, verificato sulle fonti e revisionato da una persona prima di uscire.',
    back: 'Torna alla home',
    aiLabel: 'Generato con IA, revisionato da una persona',
  },
  en: {
    title: 'Magazine',
    head: 'ARCHIVE · EVERY ISSUE',
    intro: 'One issue a month on AI, security and governance at work: the problem, the call made, what changed. A pipeline writes it, checked against the sources and reviewed by a person before it ships.',
    back: 'Back to home',
    aiLabel: 'AI-generated, human-reviewed',
  },
}[lang];

const voci = numeri.map((n) => ({
  href: getRelativeLocaleUrl(lang, `magazine/${magazineSlug(n)}`),
  title: n.data.title,
  label: `N.${String(n.data.number).padStart(2, '0')} · ${n.data.month.toUpperCase()} · ${n.data.sector}`,
  date: n.data.date,
  problem: n.data.problem.length > 200 ? n.data.problem.slice(0, 197).trimEnd() + '…' : n.data.problem,
}));

const listaLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: voci.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(v.href, Astro.site).href,
    name: v.title,
  })),
});

// L'etichetta art. 50 AI Act sta su ogni numero: sta anche sull'elenco che li
// raccoglie, con lo stesso link alla pagina di trasparenza.
const aiUrl = getRelativeLocaleUrl(lang, 'ai');
---

<BaseLayout lang={lang} title={`${copy.title} — Bellingeri`} description={copy.intro} path="magazine">
  <script type="application/ld+json" set:html={listaLd} slot="head" />
  <UtilityBar />
  <main id="main-content">
    <div class="idx-wrap">
      <p class="certs-head mono">{copy.head}</p>
      <h1 class="display idx-title">{copy.title}</h1>
      <p class="idx-intro">{copy.intro}</p>
      <p class="idx-ai mono"><a href={aiUrl}>{copy.aiLabel}</a></p>

      <ol class="idx-list">
        {voci.map((v) => (
          <li class="idx-item">
            <time class="idx-date mono" datetime={v.date.toISOString().slice(0, 10)}>{v.label}</time>
            <h2 class="idx-item-title"><a href={v.href}>{v.title}</a></h2>
            <p class="idx-desc">{v.problem}</p>
          </li>
        ))}
      </ol>

      <a class="util-btn idx-back" href={getRelativeLocaleUrl(lang, '')}>← {copy.back}</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .idx-wrap{ max-width:760px; margin:0 auto; padding:56px 24px 48px; }
  .idx-title{ font-size:clamp(28px, 5.5vw, 48px); line-height:0.98; margin:0 0 16px; }
  .idx-intro{ font-size:16px; line-height:1.65; margin:0 0 10px; opacity:0.85; }
  .idx-ai{ font-size:11px; letter-spacing:0.06em; opacity:0.7; margin:0 0 8px; }
  .idx-list{ list-style:none; margin:0; padding:0; }
  .idx-item{ border-top:3px double var(--ink); padding:26px 0 4px; }
  .idx-date{ font-size:11px; letter-spacing:0.08em; opacity:0.65; }
  .idx-item-title{ font-size:22px; line-height:1.2; margin:6px 0 8px; }
  .idx-item-title a{ text-decoration:none; }
  .idx-item-title a:hover{ color:var(--orange-text); text-decoration:underline; }
  .idx-desc{ font-size:15px; line-height:1.6; margin:0 0 18px; opacity:0.82; }
  .idx-back{ display:inline-block; margin-top:36px; text-decoration:none; }
</style>
