---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UtilityBar from '../../../components/UtilityBar.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { writingSlug } from '../../../lib/writing';
import type { Lang } from '../../../i18n/ui';

// La radice della collection esisteva come segmento di URL e non come pagina:
// /it/writing dava 404 mentre /it/writing/<slug> rispondeva. Un lettore che
// arriva da dev.to (il canonical punta qui) tagliava l'indirizzo e non trovava
// niente, e i crawler vedevano articoli senza un genitore. Ora c'è l'indice.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

const articoli = (await getCollection('writing', (a) => a.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const copy = {
  it: {
    title: 'Articoli',
    head: 'ARCHIVIO · TUTTI I PEZZI',
    intro: "Pezzi scritti a mano su cose successe davvero: un difetto trovato, la misura che l'ha smascherato, cosa è cambiato dopo. La casa canonica è qui, le copie stanno altrove.",
    back: 'Torna alla home',
  },
  en: {
    title: 'Writing',
    head: 'ARCHIVE · EVERY PIECE',
    intro: 'Hand-written pieces about things that actually happened: a defect found, the measurement that exposed it, what changed afterwards. The canonical home is here, the copies live elsewhere.',
    back: 'Back to home',
  },
}[lang];

const dataLunga = (d: Date) =>
  d.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const voci = articoli.map((a) => ({
  href: getRelativeLocaleUrl(lang, `writing/${writingSlug(a)}`),
  title: a.data.title,
  description: a.data.description,
  date: a.data.date,
  label: dataLunga(a.data.date).toUpperCase(),
}));

// ItemList: dice ai motori che questa pagina è l'elenco di quegli articoli, non
// una pagina qualsiasi che li nomina. L'autore sta già sul grafo #person.
const listaLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: voci.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(v.href, Astro.site).href,
    name: v.title,
  })),
});
---

<BaseLayout lang={lang} title={`${copy.title} — Bellingeri`} description={copy.intro} path="writing">
  <script type="application/ld+json" set:html={listaLd} slot="head" />
  <UtilityBar />
  <main id="main-content">
    <div class="idx-wrap">
      <p class="certs-head mono">{copy.head}</p>
      <h1 class="display idx-title">{copy.title}</h1>
      <p class="idx-intro">{copy.intro}</p>

      <ol class="idx-list">
        {voci.map((v) => (
          <li class="idx-item">
            <time class="idx-date mono" datetime={v.date.toISOString().slice(0, 10)}>{v.label}</time>
            <h2 class="idx-item-title"><a href={v.href}>{v.title}</a></h2>
            <p class="idx-desc">{v.description}</p>
          </li>
        ))}
      </ol>

      <a class="util-btn idx-back" href={getRelativeLocaleUrl(lang, '')}>← {copy.back}</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Stesse misure delle altre pagine dedicate (agentic-os, atlas): l'indice non
     porta un impianto suo. Lo <style> scoped viene hashato nella CSP. */
  .idx-wrap{ max-width:760px; margin:0 auto; padding:56px 24px 48px; }
  .idx-title{ font-size:clamp(28px, 5.5vw, 48px); line-height:0.98; margin:0 0 16px; }
  .idx-intro{ font-size:16px; line-height:1.65; margin:0 0 8px; opacity:0.85; }
  .idx-list{ list-style:none; margin:0; padding:0; }
  .idx-item{ border-top:3px double var(--ink); padding:26px 0 4px; }
  .idx-date{ font-size:11px; letter-spacing:0.08em; opacity:0.65; }
  .idx-item-title{ font-size:22px; line-height:1.2; margin:6px 0 8px; }
  .idx-item-title a{ text-decoration:none; }
  .idx-item-title a:hover{ color:var(--orange-text); text-decoration:underline; }
  .idx-desc{ font-size:15px; line-height:1.6; margin:0 0 18px; opacity:0.82; }
  .idx-back{ display:inline-block; margin-top:36px; text-decoration:none; }
</style>
