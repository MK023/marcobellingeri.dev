---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UtilityBar from '../../../components/UtilityBar.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ArchiveIndex from '../../../components/ArchiveIndex.astro';
import { writingSlug } from '../../../lib/writing';
import { ldJson } from '../../../lib/jsonld';
import { dateLocale, type Lang } from '../../../i18n/ui';

// La radice della collection esisteva come segmento di URL e non come pagina:
// /it/writing dava 404 mentre /it/writing/<slug> rispondeva. Un lettore che
// arriva da dev.to (il canonical punta qui) tagliava l'indirizzo e non trovava
// niente, e i crawler vedevano articoli senza un genitore. Ora c'è l'indice.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'it' } }];
}

const { lang } = Astro.params as { lang: Lang };

// Il filtro sulla data tiene fuori i pezzi programmati (devto --due): la
// foglia esiste comunque (il canonical deve esserci prima del cross-post), ma
// l'archivio non annuncia un articolo con una data futura ai lettori e ai
// crawler. Comparirà qui al primo deploy dopo la sua data.
const oggi = new Date();
const articoli = (await getCollection('writing', (a) => a.data.lang === lang && a.data.date <= oggi)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const copy = {
  it: {
    title: 'Articoli',
    head: 'ARCHIVIO · TUTTI I PEZZI',
    intro: "Pezzi scritti a mano su cose successe davvero: un difetto trovato, la misura che l'ha smascherato, cosa è cambiato dopo. La casa canonica è qui, le copie stanno altrove.",
    back: 'Torna alla home',
  },
  en: {
    title: 'Writing',
    head: 'ARCHIVE · EVERY PIECE',
    intro: 'Hand-written pieces about things that actually happened: a defect found, the measurement that exposed it, what changed afterwards. The canonical home is here, the copies live elsewhere.',
    back: 'Back to home',
  },
}[lang];

const dataLunga = (d: Date) =>
  d.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric' });

const voci = articoli.map((a) => ({
  href: getRelativeLocaleUrl(lang, `writing/${writingSlug(a)}`),
  titolo: a.data.title,
  sotto: a.data.description,
  datetime: a.data.date.toISOString().slice(0, 10),
  etichetta: dataLunga(a.data.date).toUpperCase(),
}));

// ItemList: dice ai motori che questa pagina è l'elenco di quegli articoli, non
// una pagina qualsiasi che li nomina. L'autore sta già sul grafo #person.
const listaLd = ldJson({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: voci.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(v.href, Astro.site).href,
    name: v.titolo,
  })),
});
---

<BaseLayout lang={lang} title={`${copy.title} — Bellingeri`} description={copy.intro} path="writing">
  <script type="application/ld+json" set:html={listaLd} slot="head" />
  <UtilityBar />
  <main id="main-content">
    <ArchiveIndex
      head={copy.head}
      titolo={copy.title}
      intro={copy.intro}
      voci={voci}
      back={{ href: getRelativeLocaleUrl(lang, ''), label: copy.back }}
    />
  </main>
  <SiteFooter />
</BaseLayout>
