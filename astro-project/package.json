{
  "name": "bellingeri-site",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run build && npm run test:csp",
    "test:csp": "node --test \"test/*.test.mjs\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.mjs\" && sed -i.bak 's|^SF:|SF:astro-project/|' coverage/lcov.info && rm coverage/lcov.info.bak"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@sentry/astro": "^10.72.0",
    "@sentry/browser": "^10.69.0",
    "@sentry/cloudflare": "^10.70.0",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "undici": "^7.29.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2"
  }
}
